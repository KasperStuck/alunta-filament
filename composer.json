{
  "name": "kasperstuck/alunta-filament",
  "description": "Filament admin pieces for Alunta billing.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "filament/filament": "^5.10.3",
    "kasperstuck/alunta-laravel": "^0.1",
    "livewire/livewire": "^4.4.8"
  },
  "autoload": {
    "psr-4": {
      "KasperStuck\\Alunta\\Filament\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KasperStuck\\Alunta\\Filament\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "name": "alunta-php-sdk",
      "type": "vcs",
      "url": "https://github.com/KasperStuck/alunta-php-sdk"
    },
    {
      "name": "alunta-laravel",
      "type": "vcs",
      "url": "https://github.com/KasperStuck/alunta-laravel"
    }
  ],
  "require-dev": {
    "larastan/larastan": "^3.13",
    "pestphp/pest": "^5.3.1",
    "phpstan/phpstan": "^2.3"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "pest --compact",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  }
}
